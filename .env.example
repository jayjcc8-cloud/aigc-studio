# ==============================================================================
#  AIGC Studio OS — 统一 API 配置文件
#  复制为 .env（已 git-ignored）并填入实际密钥。
#  格式: KEY=VALUE，不要加引号，不要有空格。
# ==============================================================================
#  已对接（有代码实现）: LLM(Kimi/Anthropic)  Seedance(Video)
#  已规划（待实现）  : Bailian/MiniMax/Hailuo/Kling/PixVerse/ElevenLabs/FishAudio
# ==============================================================================

# ── LLM（剧本/文案/分镜 — 所有工作流模板的文本生成前端）────────────────────
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# Moonshot/Kimi 代理示例:
# LLM_BASE_URL=https://api.moonshot.cn/anthropic
# LLM_MODEL=kimi-k3

# ── 阿里云百炼 DashScope（主视频网关: Wan 2.6 Flash / HappyHorse 1.1 / Wan 2.7 / Kling 3 / PixVerse）──
# BAILIAN_API_KEY=
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com

# ── MiniMax（副供应商: Hailuo 2.3 Fast 视频 + Speech 2.8 配音）──────────────
# MINIMAX_API_KEY=

# ── Seedance 2.0（Hero 镜头, 5-10% 流量, 异步任务+轮询）─────────────────────
# SEEDANCE_API_KEY=
# SEEDANCE_BASE_URL=https://api.seedance2.ai
# SEEDANCE_MODEL=seedance-2-0

# ── Kling 3 / 可灵（复杂救场镜头, 备选, 也可走百炼网关）────────────────────
# KLING_API_KEY=

# ── TTS 配音 ─────────────────────────────────────────────────────────────────
# ElevenLabs（英文, 情绪表现力强）
# ELEVENLABS_API_KEY=
# Fish Audio（中文, 情绪配音优先推荐）
# FISH_AUDIO_API_KEY=

# ── 工作流引擎参数 ──────────────────────────────────────────────────────────
# 视频生成异步任务的最大轮询时长 (秒)
SEEDANCE_MAX_POLL_SECONDS=600
# LLM 请求超时 (秒)
LLM_TIMEOUT_SECONDS=120
